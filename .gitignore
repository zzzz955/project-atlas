# Secrets — only *.example is committed
.env
.env.*
!.env.example
!.env.*.example

# Node tooling
node_modules/

# Generator runtime output
tools/logs/
tools/.gen-cache/

# server/db/migrations/*.sql is deliberately NOT ignored. Those files are the dev -> prod
# handover medium (architecture-design.md §10.1): production applies them by hand, so the history
# has to be in the repo. They carry DDL only - never connection settings.

# Runtime output
logs/
*.log
packet_dump/

# Load-measurement artefacts (architecture-design.md §16.1a). One JSONL per run plus the HTML
# tools/loadreport builds from it. These grow with every measurement and none of them is a
# source: the numbers that matter are transcribed into §16.1 by hand, which is what makes that
# table the SoT rather than whichever file happened to be lying in the tree.
reports/
*.jsonl
*.loadreport.html

# Local agent settings
.claude/settings.local.json

# plan-work / run-work DAG artifacts (any depth, incl. .wp/<slot>/)
.wp/
work_plan.md
work_prompt*

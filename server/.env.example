# Copy to server/.env and fill in. 🔴 .env is never committed - only this *.example file is.
# Values here are placeholders on purpose: no real host, key or credential belongs in the repo.

# JWKS endpoint of the platform-auth service used to verify login JWTs
# (architecture-design.md §12). Leave the host out of version control.
ATLAS_JWKS_URL=

# MySQL (architecture-design.md §10)
ATLAS_DB_HOST=
ATLAS_DB_PORT=3306
ATLAS_DB_NAME=
ATLAS_DB_USER=
ATLAS_DB_PASSWORD=

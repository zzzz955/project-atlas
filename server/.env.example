# Copy to server/.env and fill in the two blanks. 🔴 .env is never committed - only this
# *.example file is.
#
#   cp server/.env.example server/.env      # then set the two passwords below
#   docker compose --env-file server/.env up -d
#
# Every non-secret value below is a working local default, so the copy boots as-is once the
# passwords are set. 🔴 The secrets are deliberately EMPTY: a committed development password is
# exactly how a real one ends up in the repo later. compose reads these with `${VAR:?...}`, so an
# unset or empty value fails the command with the variable's name in the error - it never starts
# a container with a blank credential.

# --- secrets: you must fill these in (empty = compose refuses to run) ----------------------
ATLAS_DB_PASSWORD=
ATLAS_DB_ROOT_PASSWORD=

# JWKS endpoint of the platform-auth service used to verify login JWTs
# (architecture-design.md §12). No default: auth lands in a later slice and no code reads this
# yet, so a made-up URL here would be fiction. Leave the real host out of version control.
ATLAS_JWKS_URL=

# --- MySQL (architecture-design.md §10) ---------------------------------------------------
# ATLAS_DB_HOST is the compose service name - that is how the server container reaches mysql on
# the compose network. Point it at a real host when running outside compose.
# ATLAS_DB_ROOT_PASSWORD is compose-only: the mysql container needs it to initialize. The server
# itself never uses the root account.
#
# 🔴 Running the DB integration suite (server/tests/db_runtime_test.cpp) from the HOST rather than
# from inside compose needs ATLAS_DB_HOST=127.0.0.1 - `mysql` is a name only the compose network
# resolves. The suite skips loudly when it cannot reach a database, so a forgotten override shows
# up as ctest "Skipped" rather than as a pass:
#   docker compose --env-file server/.env up -d mysql
#   $env:ATLAS_DB_HOST='127.0.0.1'; ctest --preset windows-ci --output-on-failure
ATLAS_DB_HOST=mysql
ATLAS_DB_PORT=3306
ATLAS_DB_NAME=atlas
ATLAS_DB_USER=atlas

# TLS toward the database. 🔴 0 (the default, and the only safe production value) keeps the driver's
# own posture: TLS is negotiated AND the server certificate is verified. 1 keeps the encryption but
# accepts ANY certificate - passive sniffing is still blocked, an active man-in-the-middle is not.
#
# It exists because the stock `mysql:8.4` image generates a self-signed CA on first init, and
# MariaDB Connector/C 3.4 rejects that chain with error 2026 (architecture-design.md §15.2). The
# compose stack therefore sets this to 1 in compose.yaml itself, where the decision is visible; that
# `environment:` entry wins over whatever is written here. Only the exact string "1" enables it, and
# the server logs a WARN on every boot when it is on.
ATLAS_DB_TLS_NO_VERIFY=0

# --- deploy -------------------------------------------------------------------------------
# Which binary the entrypoint runs: fe | game | world | interworld (architecture-design.md
# §5.2, §15.3). Single image, role-branching entrypoint - not one image per server, and
# `world` / `interworld` resolve to the SAME binary (§5.2).
# 🔴 No default in compose: `build` and `up` both fail if this is unset, so a deploy always
#    states its role out loud. It must match server.ini `[server] role` - this one picks the
#    binary, that one is the runtime identity.
ATLAS_ROLE=game

# --- Redis (architecture-design.md §10.2) --------------------------------------------------
# No longer a placeholder: server/vcpkg.json carries `boost-redis` (§15.2) and the compose service
# starts by default. 🔴 Only the §10.2 allow-table roles (read cache · distributed lock · WORLD
# registry recovery copy) - never inter-server game traffic pub/sub, which bypasses the §5.2
# WORLD <-> WORLD ban and deletes the Phase-3 Relay seam.
#
# 🔴 Key names only, zero values - hosts and credentials are per-deployment and this file is
# committed (§5.4). Leave a key empty and the compose `${VAR:-default}` fallback applies
# (ATLAS_REDIS_PORT -> 6379). ATLAS_REDIS_PASSWORD is a secret: it belongs in server/.env alone.
ATLAS_REDIS_HOST=
ATLAS_REDIS_PORT=
ATLAS_REDIS_PASSWORD=

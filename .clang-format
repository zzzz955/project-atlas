# Base = Google: the project's naming rules (PascalCase functions, kPascalCase constants,
# trailing-underscore members — cpp-style.md §3) are Google's, so the format base and the
# convention it enforces agree instead of fighting each other.
---
Language: Cpp
BasedOnStyle: Google

# cpp-style.md §1 — C++20.
Standard: c++20

# cpp-style.md §2.3 — namespace body starts at indent 0 (no indent level burned),
# and the closing brace gets `}  // namespace atlas` automatically.
NamespaceIndentation: None
FixNamespaceComments: true

ColumnLimit: 100

# Matches .editorconfig (4 spaces). AccessModifierOffset follows IndentWidth so that
# access specifiers land back at column 0.
IndentWidth: 4
AccessModifierOffset: -4
